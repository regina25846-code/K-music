{
  "name": "kris-music",
  "version": "1.1.3",
  "description": "K-Music Player — Lightweight YouTube Music Player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.kris.music",
    "productName": "K-Music",
    "asar": false,
    "compression": "maximum",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "regina25846-code",
      "repo": "K-music"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "K-Music-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
